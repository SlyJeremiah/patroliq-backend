# Copy to .env (git-ignored) and fill in. All secrets come from the environment only.

# --- Core ---
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Off unless explicitly enabled. Never true in production.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Comma-separated, needed for the Django admin behind HTTPS, e.g. https://api.patroliq.example
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Empty -> SQLite file backend/db.sqlite3. Production: PostgreSQL (Neon).
# DATABASE_URL: the web process's URL. On Neon use the POOLED endpoint (host contains "-pooler"):
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
DATABASE_URL=
# DATABASE_URL_DIRECT: the DIRECT endpoint (same host without "-pooler"). `manage.py migrate` (and
# makemigrations/showmigrations/sqlmigrate/dbshell/flush) use it automatically; force it for any other
# command with DJANGO_DB_DIRECT=true.
# DATABASE_URL_DIRECT=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
DATABASE_URL_DIRECT=
# Persistent connection lifetime in seconds (default 60 on PostgreSQL, 0 on SQLite) and connect timeout.
# DB_CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=15

# --- HTTPS / headers (production) ---
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0

# --- Auth ---
# Idle lifetime of API tokens (sliding; renewed on use).
RANGER_TOKEN_IDLE_HOURS=168
WEB_TOKEN_IDLE_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Per-IP login throttle on top of per-account lockout
LOGIN_THROTTLE_RATE=30/min
# Enable Django admin (TOTP-protected) at /ops-admin/
DJANGO_ADMIN_ENABLED=true

# --- Media / uploads ---
MEDIA_ROOT=
MEDIA_MAX_BYTES=26214400
DATA_UPLOAD_MAX_BYTES=20971520

# --- Notifications ---
# console (log + NotificationLog table) | twilio_fcm
NOTIFY_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
