# Copy to .env (git-ignored) and fill in. All secrets come from the environment only.

# --- Core ---
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Off unless explicitly enabled. Never true in production.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Comma-separated, needed for the Django admin behind HTTPS, e.g. https://api.patroliq.example
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Empty -> SQLite file backend/db.sqlite3. Production: PostgreSQL (Neon).
# DATABASE_URL: the web process's URL. On Neon use the POOLED endpoint (host contains "-pooler"):
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
DATABASE_URL=
# DATABASE_URL_DIRECT: the DIRECT endpoint (same host without "-pooler"). `manage.py migrate` (and
# makemigrations/showmigrations/sqlmigrate/dbshell/flush) use it automatically; force it for any other
# command with DJANGO_DB_DIRECT=true.
# DATABASE_URL_DIRECT=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
DATABASE_URL_DIRECT=
# Persistent connection lifetime in seconds (default 60 on PostgreSQL, 0 on SQLite) and connect timeout.
# DB_CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=15

# --- HTTPS / headers (production) ---
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0

# --- Auth ---
# Idle lifetime of API tokens (sliding; renewed on use).
RANGER_TOKEN_IDLE_HOURS=168
WEB_TOKEN_IDLE_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Per-IP login throttle on top of per-account lockout
LOGIN_THROTTLE_RATE=30/min
# Enable Django admin (TOTP-protected) at /ops-admin/
DJANGO_ADMIN_ENABLED=true

# --- Media / uploads ---
MEDIA_ROOT=
MEDIA_MAX_BYTES=26214400
DATA_UPLOAD_MAX_BYTES=20971520
# Optional private Cloudflare R2 bucket for uploads + generated reports (all four required to enable).
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT_URL=   (default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_LOCATION=       (optional key prefix inside the bucket)

# --- Web dashboard (spec §7) ---
# Comma-separated exact origins, e.g. https://patroliq-dashboard.vercel.app
CORS_ALLOWED_ORIGINS=
# Optional regex, e.g. ^https://patroliq-dashboard-[a-z0-9-]+\.vercel\.app$  (local dev: ^http://(localhost|127\.0\.0\.1):\d+$)
CORS_ALLOWED_ORIGIN_REGEX=
# Optional comma-separated CIDRs; when set, web roles and web sign-in from other IPs get 403 ip_not_allowed.
WEB_IP_ALLOWLIST=
# Reverse proxies appending to X-Forwarded-For (Render: 1; default 1 when RENDER is set, else 0).
TRUSTED_PROXY_COUNT=
# Optional dashboard base URL for report share links; share lifetime in hours.
DASHBOARD_URL=
REPORT_SHARE_HOURS=48
# How long a computed kernel density surface stays cached (areas/{id}/heatmap/). New synced records
# invalidate it regardless, because the cache key carries the newest source record's updated_at.
HEATMAP_CACHE_SECONDS=600

# --- Notifications (see README "Notifications") ---
# SMS/push provider: console (log + NotificationLog table) | twilio_fcm
NOTIFY_BACKEND=console
# Deliver after the request commits on a background thread pool (true in production; tests run inline).
NOTIFY_ASYNC=true
NOTIFY_WORKERS=2
# Numbers without a country code are read as this country: 0771234567 -> +263771234567
SMS_DEFAULT_COUNTRY_CODE=263
# Twilio: the account SID is always required. Auth = API key (SK... + secret, preferred) or the auth token.
# Sender = a Messaging Service SID (MG...) or an SMS-capable number the account owns.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
# Email over SMTP. Empty EMAIL_HOST = not configured: emails are printed to the console and logged as skipped.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
# e.g. PATROLIQ Alerts <alerts@example.org>  (must be an address/domain the SMTP account may send as)
DEFAULT_FROM_EMAIL=
# Alert emails (SOS, dead man's switch, HWC, high/critical threats) and sync summary emails.
EMAIL_ALERTS=true
EMAIL_SYNC_SUMMARIES=true

# Two-factor sign-in for managers/admins. false = email + password only (demos). Default true.
WEB_TOTP_REQUIRED=true
